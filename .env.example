# Apify API Configuration
# Get your credentials from https://console.apify.com/account/integrations
APIFY_USER_ID=your_user_id_here
APIFY_TOKEN=your_api_token_here

# Job Search Parameters
JOB_TITLES="Software Engineer,Senior PHP Developer,Laravel Developer"
KEYWORDS=PHP,Laravel,Symfony
LOCATION="Australia and New Zealand"
MAX_RESULTS=500
MAX_JOB_AGE_DAYS=7

# LinkedIn Search Parameters
# LINKEDIN_WORK_TYPE: 1=On-site, 2=Remote, 3=Hybrid (leave empty for all)
LINKEDIN_WORK_TYPE=2
# LINKEDIN_EXPERIENCE_LEVEL: 1=Internship, 2=Entry, 3=Associate, 4=Mid-Senior, 5=Director+ (leave empty for all)
LINKEDIN_EXPERIENCE_LEVEL=4
# LINKEDIN_JOB_TYPE: fulltime,parttime,contract,temporary,internship (leave empty for all)
LINKEDIN_JOB_TYPE=fulltime
# LINKEDIN_DATE_POSTED: day,week,month,anytime (controls how recent jobs are)
LINKEDIN_DATE_POSTED=week

# Seek Search Parameters
SEEK_SALARY_MIN=100000
SEEK_SALARY_MAX=1000000
# SEEK_WORK_ARRANGEMENTS: remote,onsite,hybrid (comma-separated)
SEEK_WORK_ARRANGEMENTS=remote,hybrid

# Email Configuration
# Sign up at https://postmarkapp.com for transactional email service
EMAIL_PROVIDER=postmark
EMAIL_ADDRESS=your-email@domain.com
POSTMARK_API_TOKEN=your_postmark_server_token
FROM_EMAIL=noreply@yourdomain.com

# Scheduling Configuration
SCHEDULE_MORNING=09:00
SCHEDULE_AFTERNOON=17:00
TIMEZONE=Australia/Sydney

# Optional: AI API Keys (not required for core functionality)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key